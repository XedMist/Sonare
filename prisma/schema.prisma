generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/generated/zod"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String @unique
  displayName String?
  firstName   String?
  lastName    String?
  bio         String?
  country     String?
  birthdate   DateTime?
  avatarObjectKey String?
  password String

  playlists Playlist[]

  roleID String @db.ObjectId
  role   Role   @relation(fields: [roleID], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favoritosID String? @db.ObjectId
}

model Track {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  path      String
  name      String
  duration  Int
  thumbnail String
  lyrics    String?

  // Spotify metadata
  popularity Int?
  spotifyId  String?  // Spotify track ID for deduplication (indexed but not unique due to nulls)

  albumID String? @db.ObjectId
  album   Album?  @relation(fields: [albumID], references: [id])

  // Primary artist (for backwards compatibility)
  artistID String @db.ObjectId
  artist   Artist @relation(fields: [artistID], references: [id])

  // All artists (many-to-many)
  trackArtists TrackArtist[]

  playlistItems PlaylistTrack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([albumID])
  @@index([artistID])
}

// Junction table for Track-Artist many-to-many relationship
model TrackArtist {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  trackId  String @db.ObjectId
  artistId String @db.ObjectId
  role     ArtistRole @default(PRIMARY)

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([trackId, artistId])
  @@index([trackId])
  @@index([artistId])
}

enum ArtistRole {
  PRIMARY
  FEATURED
}

model Artist {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  // Spotify metadata
  image      String?
  popularity Int?
  genres     String[]

  albums Album[]
  tracks Track[]
  
  // All tracks this artist is on (many-to-many)
  trackArtists TrackArtist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Album {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  cover String?

  // Spotify metadata
  popularity Int?

  artistID String @db.ObjectId
  artist   Artist @relation(fields: [artistID], references: [id])

  tracks Track[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Playlist {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  userID String @db.ObjectId
  user   User   @relation(fields: [userID], references: [id])

  items PlaylistTrack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userID])
  @@index([name])
}

model PlaylistTrack {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  playlistId String   @db.ObjectId
  trackId    String   @db.ObjectId
  position   Int?
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id])
  track    Track    @relation(fields: [trackId], references: [id])

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
}

model Role {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique

  permisionsID String[]    @db.ObjectId
  permisions   Permision[] @relation(fields: [permisionsID], references: [id])

  User User[]
}

model Permision {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  capability Capability
  resource   String

  rolesID String[] @db.ObjectId
  roles   Role[]   @relation(fields: [rolesID], references: [id])
}

enum Capability {
  READ
  CREATE
  DELETE
  UPDATE
}
